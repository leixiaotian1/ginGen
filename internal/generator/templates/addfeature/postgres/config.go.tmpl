package config

// PostgreSQLConfig holds PostgreSQL specific configurations.
type PostgreSQLConfig struct {
	DSN             string `mapstructure:"dsn"`              // PostgreSQL DSN
	MaxIdleConns    int    `mapstructure:"max_idle_conns"`  // Maximum idle connections
	MaxOpenConns    int    `mapstructure:"max_open_conns"`  // Maximum open connections
	ConnMaxLifetime int    `mapstructure:"conn_max_lifetime"` // Connection max lifetime in seconds
}

