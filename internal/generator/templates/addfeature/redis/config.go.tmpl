package config

// RedisConfig holds Redis specific configurations.
type RedisConfig struct {
	Addr         string `mapstructure:"addr"`           // Redis server address, e.g., "localhost:6379"
	Password     string `mapstructure:"password"`     // Redis password (empty if no password)
	DB           int    `mapstructure:"db"`            // Redis database number (default: 0)
	PoolSize     int    `mapstructure:"pool_size"`     // Maximum number of socket connections
	MinIdleConns int    `mapstructure:"min_idle_conns"` // Minimum number of idle connections
	DialTimeout  int    `mapstructure:"dial_timeout"`  // Dial timeout in seconds
	ReadTimeout  int    `mapstructure:"read_timeout"`  // Read timeout in seconds
	WriteTimeout int    `mapstructure:"write_timeout"` // Write timeout in seconds
}

